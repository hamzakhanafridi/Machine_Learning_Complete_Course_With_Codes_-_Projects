import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split


df= pd.read_csv('2 loan_approval_data.csv')


df.head()


df.info()


df.describe()


df.isnull().sum()


catagorical=df.select_dtypes(include=['object']).columns
numerical=df.select_dtypes(include=['number']).columns





from sklearn.impute import SimpleImputer
# filling numerical missing values
num_imp = SimpleImputer(strategy='mean')
df[numerical]=num_imp.fit_transform(df[numerical])


# Filling catagorical missing values with most frequent
cat_imp = SimpleImputer(strategy='most_frequent')
df[catagorical]=cat_imp.fit_transform(df[catagorical])


df.isnull().sum()





loan_count=df['Loan_Approved'].value_counts()
plt.pie(loan_count,labels=['No', 'Yes'],autopct='%1.2f%%')
plt.title('Loan Approved Or Not')


gen_cnt=df['Gender'].value_counts()
ax=sns.barplot(gen_cnt)
ax.bar_label(ax.containers[0])


edu_cnt=df['Education_Level'].value_counts()
ax=sns.barplot(edu_cnt)
ax.bar_label(ax.containers[0])



marig_cnt=df['Marital_Status'].value_counts()
ax=sns.barplot(marig_cnt)
ax.bar_label(ax.containers[0])



