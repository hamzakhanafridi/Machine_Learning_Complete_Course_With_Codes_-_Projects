import pandas as pd
import seaborn as sns


df=pd.read_csv('insurance.csv')


df.head()


sns.scatterplot(x=df['bmi'], y=df['charges'], hue=df['smoker'])


x=df.drop(columns=['charges', 'region'])
y=df['charges']


x.head()


y.head()


x['sex']=x['sex'].map({'male':1, 'female':0})


x['smoker']=x['smoker'].map({'yes':1, 'no':0})


x.head()


from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
x_train, x_test, y_train, y_test = train_test_split(
    x, y, test_size=0.2, random_state=42)


reg=LinearRegression()
reg.fit(x_train,y_train)


y_pred= reg.predict(x_test)


y_pred


y_test





from sklearn.metrics import r2_score
r2=r2_score(y_test, y_pred)
print('r_Square is: ', r2)


x_test.shape


n=x_test.shape[0]
p=x_test.shape[1]
adj_r2=1-((1-r2)*(n-1)/(n-p-1))
print('The value of adjusted r2 is: ', adj_r2)





x=df.drop(columns=['charges'])
y=df['charges']

x=pd.get_dummies(x, columns=['region'], drop_first=False, dtype=int)   # one hot encoding
x['smoker']=x['smoker'].map({'yes':1, 'no':0})
x['sex']=x['sex'].map({'male':1, 'female':0})


x.head()



x_train, x_test, y_train, y_test = train_test_split(
    x, y, test_size=0.2, random_state=42)

reg.fit(x_train,y_train)
y_pred= reg.predict(x_test)

r2=r2_score(y_test, y_pred)
print('r_Square is: ', r2)


# Interaction features

x['age_smoker']=x['age']*x['smoker']
x['bmi_smoker']=x['bmi']*x['smoker']    # due to these interaction features the results imporves a lot


x_train, x_test, y_train, y_test = train_test_split(
    x, y, test_size=0.2, random_state=42)

reg.fit(x_train,y_train)
y_pred= reg.predict(x_test)

r2=r2_score(y_test, y_pred)
print('r_Square is: ', r2)


