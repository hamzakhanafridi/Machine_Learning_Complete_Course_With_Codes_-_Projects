# Vector normalization
vec=np.array([[1,2],[3,4]])
mean=np.mean(vec)
std=np.std(vec)
normalization=(vec-mean)/std
print(normalization)


new_mean=np.mean(normalization)    # the mean of normalized vector is always zero 
new_std=np.std(normalization)      # while the std of normalized vector is 1 or close to 1
print(new_mean)
print(new_std)


#  Mathematical functions in numpy
a=np.array([1,2,4,5,6,7])
print(np.mean(a))
print(np.median(a))
print(np.std(a))
print(np.var(a))
print(np.argmax(a))
print(np.argmin(a))


# Logs functions
