import requests
import pandas as pd
from bs4 import BeautifulSoup


url='https://www.scrapethissite.com/pages/simple/'
res=requests.get(url)


if res.status_code==200:
    print(res.text)


with open('scraped_data/data2.html','w', encoding='utf-8') as f:
    f.write(res.text)


%pip install lxml


with open('scraped_data/data2.html') as f:
    content=f.read()

soup=BeautifulSoup(content, "html.parser")


soup


data=soup.find_all('h3')


data


dat=[]
for h3 in data:
    names=h3.get_text(strip=True)
    pop=h3.find_next('div').select('span.country-population')[0].get_text(strip=True)

dat.append([names,pop])


df=pd.DataFrame(dat, columns=['Names', 'Population'])


df



