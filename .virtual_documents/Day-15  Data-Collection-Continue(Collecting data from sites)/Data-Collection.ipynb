import requests


url='https://www.scrapethissite.com/pages/simple/'
res=requests.get(url)


if res.status_code == 200:
    print(res.text)


with open ('scraped_data/data1.html', 'w', encoding='utf-8') as f:    # this is best practice for web scraping in python in windows system ye unicode har character ko computer keleye encode kar ke save karta he es se error nahi ata per 
    f.write(res.text)





pip install beautifulsoup4


#pip install lxml


from bs4 import BeautifulSoup


with open('scraped_data/data1.html') as f:
    content=f.read()

soup=BeautifulSoup(content, "lxml")   # matlab es lxml parser ke zarye es html ko read karo


soup


h3_data=soup.find_all('h3')


h3_data


data=[]
for h3 in h3_data:
    name=h3.get_text(strip=True)
    population=h3.find_next('div').select('span.country-population')[0].get_text(strip=True)
    area=h3.find_next('div').select('span.country-area')[0].get_text(strip=True)

    data.append([name, population,area])

# or you can also write it in the form of list comprehension   names=[h3.get_text(strip=True) for h3 in h3_data]


import pandas as pd


df=pd.DataFrame(data, columns=['Country', 'Population','Area'])


df


df.to_csv('scraped_data/data.csv', index=False)


df['Area'].isna().sum()


df['Area'] = df['Area'].astype(float).astype(int)


df.to_csv('scraped_data/data.csv', index=False)



